# ==============================================================================
# RISEHER – ENVIRONMENT CONFIGURATION
# AI-Powered Women Entrepreneurship Decision-Support & Networking Platform
# ==============================================================================

ENVIRONMENT=development
APP_NAME="RiseHer Intelligence Engine"
API_HOST=127.0.0.1
API_PORT=8001
FRONTEND_PORT=5173
DEBUG=True

# ------------------------------------------------------------------------------
# 1. DATABASE & SECURITY
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./backend/riseher.db
SECRET_KEY=riseher-super-secret-key-empowering-women-entrepreneurs-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. REAL EMAIL DELIVERY CONFIGURATION (SMTP / Resend / SendGrid)
# ------------------------------------------------------------------------------
# Configure a working email service to receive real 6-digit verification codes.
# Common setups:
# - Gmail SMTP:     EMAIL_HOST=smtp.gmail.com | EMAIL_PORT=587 | EMAIL_USE_TLS=True | EMAIL_PASSWORD=<16-char App Password>
# - SendGrid SMTP:  EMAIL_HOST=smtp.sendgrid.net | EMAIL_PORT=587 | EMAIL_USERNAME=apikey | EMAIL_PASSWORD=<API_KEY>
# - Brevo / SES:    EMAIL_HOST=smtp-relay.brevo.com | EMAIL_PORT=587
# - Resend API:     RESEND_API_KEY=re_xxxxxxxxx
# Set to 'true' to test OTP delivery locally without third-party credentials:
EMAIL_DEV_MODE=false

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@riseher.org
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Optional Resend / SendGrid HTTP API keys:
RESEND_API_KEY=
RESEND_FROM=
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 3. REAL MOBILE SMS DELIVERY CONFIGURATION (Twilio / MSG91 / Fast2SMS)
# ------------------------------------------------------------------------------
# Configure a live carrier SMS gateway to deliver SMS OTPs to mobile numbers.
# Supports +91 Indian mobile numbers and international E.164.
# ------------------------------------------------------------------------------
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=RISEHR

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 Configuration (DLT India)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=RISEHR

# Fast2SMS Configuration (India)
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# 4. OFFICIAL SCHEME DATA & AI
# ------------------------------------------------------------------------------
WEP_PORTAL_REFERENCE_URL=https://wep.gov.in/
PMEGP_PORTAL_URL=https://www.kviconline.gov.in/pmegp/
MUDRA_PORTAL_URL=https://www.mudra.org.in/
GEMINI_API_KEY=
OPENAI_API_KEY=
